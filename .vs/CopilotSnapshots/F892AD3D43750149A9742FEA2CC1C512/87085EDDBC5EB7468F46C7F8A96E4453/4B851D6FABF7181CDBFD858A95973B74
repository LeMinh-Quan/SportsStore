@* Khai báo kiểu dữ liệu mà Controller gửi xuống chính là class CartIndexViewModel *@
@model SportsStore.WebUI.Models.CartIndexViewModel

@{
    // Cài đặt tiêu đề hiển thị trên Tab của trình duyệt
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<h2 class="mb-4">Giỏ hàng của bạn</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Số lượng</th>
            <th>Sản phẩm</th>
            <th class="text-end">Đơn giá</th>
            <th class="text-end">Thành tiền</th>
            <th class="text-center">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @* Nếu danh sách Lines trong giỏ hàng rỗng *@
        @if (Model.Lines.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Giỏ hàng trống</td>
            </tr>
        }

        @* Quét qua từng dòng sản phẩm trong giỏ hàng *@
        @foreach (var line in Model.Lines)
        {
            <tr>
                <td class="text-center">@line.Quantity</td>
                <td>@line.Product.Name</td>
                <td class="text-end">@line.Product.Price.ToString("C")</td>
                <td class="text-end">@((line.Quantity * line.Product.Price).ToString("C"))</td>
                <td class="text-center">
                    <form asp-action="RemoveFromCart" method="post">
                        <input type="hidden" name="productId" value="@line.Product.ProductID" />
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
            <td class="text-end fw-bold text-danger">@Model.ComputeTotalValue().ToString("C")</td>
            <td></td>
        </tr>
    </tfoot>
</table>

<div class="text-center mt-3">
    <a class="btn btn-secondary" href="@(ViewBag.ReturnUrl ?? "/")">Tiếp tục mua sắm</a>
    <a class="btn btn-success" asp-controller="Order" asp-action="Checkout">Thanh toán ngay</a>
</div>