<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - SportsStore</title>
	<link rel="stylesheet" href="~/css/bootstrap.min.css" />
</head>
<body>
	<header style="display:flex; flex-direction:row; justify-content: space-between; align-items: center;" class="bg-dark text-white p-2">
		<div class="container-fluid" style="display:flex; justify-content: space-between; align-items: center;">
			<span class="navbar-brand ml-2">SPORTS STORE</span>

			<!-- CartSummary component (hiển thị tóm tắt giỏ hàng) -->
			@await Component.InvokeAsync("CartSummary")

			<!-- Nút xem giỏ hàng -->
			<a class="btn btn-outline-light"
			   asp-controller="Cart"
			   asp-action="Index"
			   asp-route-returnUrl="@Context.Request.Path">
				🛒 Xem giỏ hàng
			</a>
		</div>
		
	</header>

	<div class="container-fluid mt-4">
		<div class="row">
			<aside class="col-md-3">
				@await Component.InvokeAsync("NavigationMenu")
			</aside>

			<main class="col-md-9">
				@RenderBody()
			</main>
		</div>
	</div>

	<footer class="border-top footer text-muted text-center p-3">
		<div class="container">
			&copy; 2025 - SportsStore
		</div>
	</footer>

	<script src="~/js/bootstrap.bundle.min.js"></script>
</body>
</html>